#!/usr/bin/env python3
"""Atajo de teclado de ARTHUR: enciende / apaga la cámara de los gestos.

Hyprland lo ejecuta al pulsar Super+Shift+G. Solo envía la orden fija "toggle-camera"
al buzón privado de ARTHUR ($XDG_RUNTIME_DIR/arthur/control.sock). Encender así es como
pulsar el botón del Orb: sale la notificación de la cámara y el punto rojo. Si ARTHUR
no está en marcha (o los gestos no están activados), muestra una notificación.
"""

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from arthur.api.control import ControlUnavailable, send_command  # noqa: E402


def notify(text: str) -> None:
    subprocess.run(["notify-send", "--app-name=ARTHUR", "--expire-time=4000", "--", "ARTHUR · Cámara", text],
                   check=False)


try:
    answer = send_command("toggle-camera")
except ControlUnavailable as e:
    notify(f"{e}. Arráncalo con: systemctl --user start arthur")
    sys.exit(1)
print(answer)
if answer.startswith("error"):
    # «orden desconocida»: el servicio corre sin gestos ([gestures] enabled = false en config.toml)
    notify("Los gestos no están activados: pon enabled = true en [gestures] de config.toml y reinicia ARTHUR.")
    sys.exit(1)
