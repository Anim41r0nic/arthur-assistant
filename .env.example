# Copia de ejemplo de .env (lo crea scripts/instalar-servidor.sh con lo que elijas). .env nunca va al repositorio.

# Qué ficheros de compose se usan: añade compose.tailscale.yaml y/o compose.gpu.yaml separados por «:».
COMPOSE_FILE=compose.yaml

# Tu zona horaria (la hora de las respuestas y de los recordatorios).
TZ=Europe/Madrid

# Quién manda los avisos al móvil (lo exigen Apple y Google): https://… (la web de tu ARTHUR) o mailto:tu@correo.
ARTHUR_PUSH_SUBJECT=https://tu-servidor.tu-red.ts.net

# Con compose.tailscale.yaml: la IP de Tailscale de este servidor (tailscale ip -4).
ARTHUR_TAILSCALE_IP=100.64.0.10

# Con compose.gpu.yaml: el nodo render de la gráfica integrada (ls -l /dev/dri/by-path/).
ARTHUR_GPU_RENDER=/dev/dri/by-path/pci-0000:00:02.0-render
