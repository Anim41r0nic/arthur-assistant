# Copia de ejemplo de .env (lo crea scripts/instalar-servidor.sh con lo que elijas). .env nunca va al repositorio.

# Qué ficheros de compose se usan: añade compose.tailscale.yaml y/o compose.gpu.yaml separados por «:».
COMPOSE_FILE=compose.yaml

# Tu zona horaria (la hora de las respuestas y de los recordatorios).
TZ=Europe/Madrid

# Quién manda los avisos al móvil (lo exigen Apple y Google): https://… (la web de tu ARTHUR) o mailto:tu@example.com.
ARTHUR_PUSH_SUBJECT=https://tu-servidor.tu-red.ts.net

# Con compose.tailscale.yaml: la IP de Tailscale de este servidor (tailscale ip -4).
ARTHUR_TAILSCALE_IP=100.64.0.10

# Con compose.gpu.yaml: el nodo render de la gráfica integrada (ls -l /dev/dri/by-path/).
ARTHUR_GPU_RENDER=/dev/dri/by-path/pci-0000:00:02.0-render

# --- Servicios opcionales (compose.yaml, docs/servidor.md) ------------------------------------------------------
# Qué perfiles arrancan: apuntes, panel, clientes, webchat, cerebro (separados por comas). Lo rellena
# scripts/desplegar.sh, que también crea sus llaves internas en secrets/ sin enseñarlas.
COMPOSE_PROFILES=

# Conexiones por la red interna de Docker. Vacías = sin conectar. scripts/desplegar.sh las pone cuando el servicio y
# su llave están listos; si las escribes a mano, crea antes la llave (o el chat dará «no disponible»).
ARTHUR_APUNTES_URL=
ARTHUR_PANEL_URL=
ARTHUR_CEREBRO_URL=
ARTHUR_STUDIO_URL=
ARTHUR_WEBCHAT_CLIENTES_URL=

# Las direcciones que abres tú desde el móvil (por Tailscale): los avisos abren ahí el Repaso, el panel, el cliente
# o el vídeo. Solo la raíz, sin ruta. Ejemplos con la IP de Tailscale de arriba:
ARTHUR_APUNTES_PUBLIC_URL=http://100.64.0.10:8774
ARTHUR_PANEL_PUBLIC_URL=http://100.64.0.10:8775
ARTHUR_CLIENTES_PUBLIC_URL=http://100.64.0.10:8777
ARTHUR_STUDIO_PUBLIC_URL=

# Tu bóveda de Obsidian en el servidor (la trae Syncthing): el panel lee y marca sus casillas «Yo:» y el cerebro la
# lee (solo lectura). Una segunda bóveda opcional (p. ej. la de tu negocio), solo para el cerebro.
ARTHUR_BOVEDA=./obsidian/cerebro
ARTHUR_BOVEDA_NEGOCIO=./obsidian/negocio

# Cloudflare Workers AI (capa gratis; chat de la web, resumen del panel y cerebro). El id de cuenta no es secreto;
# el token va en secrets/workers_ai_token. Sin él, contesta Ollama.
ARTHUR_CF_ACCOUNT=

# El chat de tu web pública (docs/webchat.md). La clave SECRETA de Turnstile va en secrets/turnstile_secret.
ARTHUR_WEBCHAT_ORIGIN=https://ejemplo.com
ARTHUR_WEBCHAT_NOMBRE=
ARTHUR_WEBCHAT_CORREO=hola@ejemplo.com
ARTHUR_WEBCHAT_CONOCIMIENTO=./conocimiento.md

# Creator Studio (docs/studio.md): el @ de cada canal (se comprueba antes de cada subida) y el contacto que Studio
# da a Wikimedia (una URL pública: tu canal o tu web). Con los de ejemplo no se sube nada.
ARTHUR_STUDIO_CANAL_ESTOICISMO_ES=@TuCanalEstoicismo
ARTHUR_STUDIO_CANAL_ESTOICISMO_EN=@TuCanalStoicEN
ARTHUR_STUDIO_CANAL_FRUTINOVELAS=@TuCanalFrutinovelas
ARTHUR_STUDIO_CONTACTO=https://www.youtube.com/@TuCanalEstoicismo
